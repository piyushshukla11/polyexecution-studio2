# PolyExecution Studio 2 (PES 2) Environment Configuration
# Copy this file to .env and adjust values as needed for your host environment.
# Never commit .env or secrets to version control.

# Host interface to bind reverse proxy and public services (defaults strictly to loopback 127.0.0.1)
PES2_BIND_HOST=127.0.0.1
PES2_PORT=8088

# Optional secret key for remote API Gateway access.
# Required if binding API Gateway or reverse proxy to a non-loopback host interface.
# When set, all incoming /api/ requests must provide Bearer <token> or X-API-Key header.
PES2_API_KEY=

# Execution Worker Daemon configuration (private container mesh)
PES2_DAEMON_PORT=50051
PES2_DAEMON_WORKERS=8
PES2_DAEMON_CAPACITY=16
PES2_DAEMON_MEMORY_MB=1024

# API Gateway configuration
PES2_GATEWAY_PORT=8000
PES2_GATEWAY_TIMEOUT_SEC=30.0

